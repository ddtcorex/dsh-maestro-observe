{
  "name": "@ddtcorex/dsh-maestro-observe",
  "version": "0.2.1",
  "private": false,
  "packageManager": "pnpm@11.7.0",
  "description": "Maestro observe — trace/health/cost debug tooling (Phase 3)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddtcorex/dsh-maestro-observe.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs && test -f lib/client.js",
    "verify": "tsc --noEmit",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "schemastery": "^3.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.8.0",
    "vitest": "^2.0.0"
  }
}
